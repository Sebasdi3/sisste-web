# =====================================================================
# Variables NUEVAS que hay que AGREGAR al .env real de la raíz del
# proyecto (junto a DB_USER, DB_HOST, etc. que ya existen). Este archivo
# es solo una plantilla con valores de ejemplo: NO contiene secretos
# reales y NO reemplaza a tu .env.
# =====================================================================

# Base de datos de auditoría (separada de sigesot_db)
AUDIT_DB_NAME=sigesot_audit
AUDIT_DB_USER=sigesot_audit_svc
AUDIT_DB_PASSWORD=la_misma_clave_que_pusiste_para_sigesot_audit_svc_en_000_provision_infra.sql

# Opcionales: si se omiten, se usan DB_HOST y DB_PORT del sistema principal.
# AUDIT_DB_HOST=localhost
# AUDIT_DB_PORT=5432

# NUNCA agregues aquí la contraseña del rol sigesot_audit_owner: la
# aplicación no debe conocerla ni usarla jamás.
